# Copy to .env and fill in. One value per line, nothing after the value.

# Required: every LLM call goes through OpenRouter.
OPENROUTER_API_KEY=
# Paid data services. Exactly these three; the ladder measures each one.
PERPLEXITY_API_KEY=
EXA_API_KEY=
FIRECRAWL_API_KEY=
# Free tools. The token only raises the GitHub rate limit.
GITHUB_TOKEN=

# Models (OpenRouter ids). The judge must be a different model family from the lead.
LEAD_MODEL=anthropic/claude-opus-5
JUDGE_MODEL=openai/gpt-5.6-luna

# Tool set for a run: comma list from github,gravatar,wayback,whatsmyname,perplexity,exa,firecrawl
TOOLS=github,gravatar,wayback,whatsmyname,openalex,roblox,tinder,holehe,peoplesearch,profiles,perplexity,exa,firecrawl
DEEP_DIVE=1

# Budget per run. The tightest cap ends the run. Data-tool calls only; bookkeeping calls are free.
MAX_TOOL_CALLS=40
MAX_USD=2.5
MAX_SECONDS=1500
SATURATION_DRY_STEPS=3

# Optional: protects the deployed endpoint's budget overrides.
AGENT_API_KEY=
NUDGE_FRONTIER=1
NUDGE_INPUT_SHAPE=1
EXTRACTOR=1
EXTRACTOR_MODEL=anthropic/claude-haiku-4.5
EXTRACTOR_CHARS=6000
SUB_MODEL=anthropic/claude-sonnet-4.5
ANCHOR_MODEL=anthropic/claude-haiku-4.5
LEAD_VIEW_CHARS=4000
NUDGE_COVERAGE=1
SWEEP=1
